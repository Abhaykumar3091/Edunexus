# ==============================================================================
# UniAssist AI — Backend Environment Configuration (.env)
# ==============================================================================

# Application Information
APP_NAME=UniAssist AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=generate_a_secure_random_string_here_min_32_characters_for_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In production on Azure Database for PostgreSQL Flexible Server:
# DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_server_name>.postgres.database.azure.com:5432/uniassist_db?ssl=require
DATABASE_URL=postgresql+asyncpg://uniassist_admin:uniassist_secure_pass_change_in_production@localhost:5432/uniassist_db
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=uniassist_local.db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Azure Services Configuration
# (If left empty, UniAssist AI will gracefully operate in offline/mock demo mode)
# ------------------------------------------------------------------------------

# 1. Azure OpenAI Service / Azure AI Foundry
# Found in Azure Portal > Azure OpenAI Service > Resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# 2. Azure AI Search Service (Foundry IQ / RAG Vector Index)
# Found in Azure Portal > Azure AI Search > Resource > Keys and Url
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key
AZURE_SEARCH_INDEX_NAME=uniassist-knowledge-index

# 3. Azure Blob Storage (University Handbooks & Knowledge Documents)
# Found in Azure Portal > Storage Account > Security + networking > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorage;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_DOCUMENTS=university-documents

# 4. Azure Key Vault (Optional for centralized secrets management)
AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
USE_AZURE_KEY_VAULT=False

# 5. Azure Application Insights / Monitor (Observability & Tracing)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your_key;IngestionEndpoint=https://...
ENABLE_APP_INSIGHTS=False

# Demo Seed Accounts
SEED_DEMO_DATA=True
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=AdminPassword123!
STUDENT_DEFAULT_EMAIL=student@example.com
STUDENT_DEFAULT_PASSWORD=StudentPassword123!
FACULTY_DEFAULT_EMAIL=faculty@example.com
FACULTY_DEFAULT_PASSWORD=FacultyPassword123!
