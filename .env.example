# ==============================================================================
# UniAssist AI - Environment Configuration Example
# Copy this file to .env and fill in your values.
# DO NOT commit .env containing real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_NAME="UniAssist AI"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY="generate-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Local Docker or Azure Database for PostgreSQL
POSTGRES_USER=uniassist_admin
POSTGRES_PASSWORD=uniassist_secure_pass_change_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uniassist_db
POSTGRES_SSLMODE=prefer

# Combined URLs (Automatically constructed or override directly):
# For asyncpg (FastAPI async engine):
DATABASE_URL="postgresql+asyncpg://uniassist_admin:uniassist_secure_pass_change_in_production@localhost:5432/uniassist_db"
# For psycopg2 (Alembic sync migrations):
SYNC_DATABASE_URL="postgresql+psycopg2://uniassist_admin:uniassist_secure_pass_change_in_production@localhost:5432/uniassist_db"

# Optional: Set to True to fallback to SQLite for quick offline testing without Docker
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH="uniassist_local.db"

# ------------------------------------------------------------------------------
# CORS Origins (Frontend URLs)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# ------------------------------------------------------------------------------
# Azure OpenAI & Microsoft AI Foundry
# ------------------------------------------------------------------------------
# From Azure Portal -> Azure OpenAI / AI Foundry -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-azure-openai-key>"
AZURE_OPENAI_API_VERSION="2024-06-01"

# Model Deployments created in Azure OpenAI / Foundry
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# Microsoft Foundry Project Connection (if using Azure AI Projects SDK)
AZURE_AI_PROJECT_CONNECTION_STRING="<your-azure-ai-project-connection-string>"

# ------------------------------------------------------------------------------
# Azure AI Search / Foundry IQ (Knowledge Base RAG)
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT="https://<your-search-service-name>.search.windows.net"
AZURE_SEARCH_API_KEY="<your-search-api-key>"
AZURE_SEARCH_INDEX_NAME="uniassist-knowledge-index"

# ------------------------------------------------------------------------------
# Azure Blob Storage (Document Store)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<storage_account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_DOCUMENTS="university-documents"

# ------------------------------------------------------------------------------
# Azure Key Vault (Production Secrets)
# ------------------------------------------------------------------------------
AZURE_KEY_VAULT_URL="https://<your-keyvault-name>.vault.azure.net/"
USE_AZURE_KEY_VAULT=False

# ------------------------------------------------------------------------------
# Azure Application Insights & Azure Monitor
# ------------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://..."
ENABLE_APP_INSIGHTS=False

# ------------------------------------------------------------------------------
# Seed Default Accounts (Demo / Initial Setup)
# ------------------------------------------------------------------------------
SEED_DEMO_DATA=True
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="AdminPassword123!"
STUDENT_DEFAULT_EMAIL="student@example.com"
STUDENT_DEFAULT_PASSWORD="StudentPassword123!"
FACULTY_DEFAULT_EMAIL="faculty@example.com"
FACULTY_DEFAULT_PASSWORD="FacultyPassword123!"
